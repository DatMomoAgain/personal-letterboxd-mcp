{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "letterboxd-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Only the one workers.dev address; no per-version preview URLs.
  "preview_urls": false,
  // The page's display font (src/fonts) is bundled into the Worker as binary data.
  "rules": [{ "type": "Data", "globs": ["**/*.woff2"], "fallthrough": true }],
  // No namespace id on purpose: on the first deploy Wrangler creates the namespace (and may write
  // its id here in your copy); later deploys keep using the one the deployed Worker already has.
  "kv_namespaces": [{ "binding": "LETTERBOXD" }]
}
